node_modules/
dist/
shots/
*.log
# `*.log` above silently swallowed the other direction too: src/*.js comments cite
# tools/logs/tour-*.log as the evidence for the numbers they state, and the ignore rule meant a
# fresh checkout had no such file — the citation was checkable only on the machine that measured it.
# The evidence directory is exactly the place where a log IS the deliverable, so it is un-ignored by
# name; stray logs anywhere else stay ignored.
!tools/logs/*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
__pycache__/
# 55 MB CC0 asset staging area — downloaded sources, not shipped game data
public/assets/web/
# The CC0 intake work area: downloaded .gltf/.bin/textures and the retinted rebuilds that
# tools/gltf_to_glb.mjs, tools/cc0-conform.mjs and tools/retint_*.py regenerate on demand. Its
# 51 MB are derived bytes, so it is ignored in stages rather than by one `staging/` line: a
# directory that is excluded outright cannot be re-opened file by file, and this directory has
# one file that is NOT derived — `staging/cc0/INTAKE.md`, the intake note that tracked tools
# cite by line number (`cc0-conform.mjs` cites `staging/cc0/INTAKE.md:36-38,42,80`). Same shape as
# the `!tools/logs/*.log` rule above: ignore the bulk, keep the citation resolvable.
staging/*
!staging/cc0/
staging/cc0/*
!staging/cc0/INTAKE.md
